<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_glass"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/widget_icon_bg"
            android:src="@drawable/ic_w_shift"
            android:scaleType="centerInside"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Смены"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8A94A0"
                android:maxLines="1"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_line0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E8EAED" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="12dp" android:layout_marginBottom="7dp" />
    <TextView android:id="@+id/widget_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E8EAED" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="7dp" />
    <TextView android:id="@+id/widget_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E8EAED" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="7dp" />
    <TextView android:id="@+id/widget_line3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E8EAED" android:maxLines="1" android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>