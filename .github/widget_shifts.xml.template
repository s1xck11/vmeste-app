<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg_glass"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Смены"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView android:id="@+id/widget_line0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E0E0E0" android:layout_marginBottom="4dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E0E0E0" android:layout_marginBottom="4dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E0E0E0" android:layout_marginBottom="4dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_line3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#E0E0E0" android:visibility="gone" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#B0B0B0"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
