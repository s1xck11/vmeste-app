<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_glass"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="📑"
            android:textSize="18sp"
            android:background="@drawable/widget_icon_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Задачи"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#9AA5B1"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_line0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E6E6E6" android:layout_marginTop="10dp" android:maxLines="1" android:visibility="gone" />
    <TextView android:id="@+id/widget_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E6E6E6" android:layout_marginTop="6dp" android:maxLines="1" android:visibility="gone" />
    <TextView android:id="@+id/widget_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E6E6E6" android:layout_marginTop="6dp" android:maxLines="1" android:visibility="gone" />
    <TextView android:id="@+id/widget_line3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E6E6E6" android:layout_marginTop="6dp" android:maxLines="1" android:visibility="gone" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#9AA5B1"
        android:layout_marginTop="10dp"
        android:visibility="gone" />
</LinearLayout>