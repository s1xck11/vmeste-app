<!-- ============ ВИДЖЕТЫ: РЕСИВЕРЫ ============ -->

<receiver
    android:name=".VmesteShiftsWidget"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_shifts_info" />
</receiver>

