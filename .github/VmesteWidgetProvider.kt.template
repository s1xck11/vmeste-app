class VmesteClockWidget : AppWidgetProvider() {
    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
        for (widgetId in appWidgetIds) {
            val views = RemoteViews(context.packageName, R.layout.widget_clock)
            val prefs = HomeWidgetPlugin.getData(context)

            // Время и дату рисует нативный TextClock сам (в процессе лаунчера).
            // Здесь только погода.
            views.setTextViewText(R.id.weather_temp, prefs.getString("clock_weather", "--°") ?: "--°")
            val cond = prefs.getString("clock_condition", "") ?: ""
            val city = prefs.getString("clock_city", "") ?: ""
            views.setTextViewText(R.id.weather_condition, cond)
            views.setViewVisibility(R.id.weather_condition, if (cond.isNotEmpty()) View.VISIBLE else View.GONE)
            views.setTextViewText(R.id.weather_city, city)
            views.setViewVisibility(R.id.weather_city, if (city.isNotEmpty()) View.VISIBLE else View.GONE)

            val adapter = Intent(context, VmesteStackService::class.java).apply {
                putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, widgetId)
            }
            views.setRemoteAdapter(R.id.widget_list, adapter)

            val base = Intent(context, MainActivity::class.java).apply {
                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP
            }
            val template = PendingIntent.getActivity(context, widgetId, base,
                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_MUTABLE)
            views.setPendingIntentTemplate(R.id.widget_list, template)

            val rootIntent = HomeWidgetLaunchIntent.getActivity(context, MainActivity::class.java, Uri.parse("vmeste://open?tab=2"))
            views.setOnClickPendingIntent(R.id.clock_block, rootIntent)

            appWidgetManager.updateAppWidget(widgetId, views)
            appWidgetManager.notifyAppWidgetViewDataChanged(widgetId, R.id.widget_list)
        }
    }
}

class VmesteStackService : RemoteViewsService() {
    override fun onGetViewFactory(intent: Intent): RemoteViewsFactory = StackFactory(applicationContext)
}

class StackFactory(private val context: Context) : RemoteViewsService.RemoteViewsFactory {
    private data class StackCard(val tab: Int, val title: String, val subtitle: String, val lines: List<String>, val isAddExpense: Boolean)
    private val items = mutableListOf<StackCard>()

    override fun onCreate() {}
    override fun onDataSetChanged() {
        items.clear()
        val prefs = HomeWidgetPlugin.getData(context)
        fun lines(key: String): List<String> = (prefs.getString(key, "") ?: "").split("\n").filter { it.isNotEmpty() }
        items.add(StackCard(0, "🛒 ${prefs.getString("purchases_title", "Покупки") ?: "Покупки"}", prefs.getString("purchases_sub", "") ?: "", lines("purchases_lines").take(3), false))
        items.add(StackCard(1, "✅ ${prefs.getString("tasks_title", "Задачи") ?: "Задачи"}", prefs.getString("tasks_sub", "") ?: "", lines("tasks_lines").take(3), false))
        items.add(StackCard(2, "💼 Смена сегодня", "", lines("clock_shifts").take(3), false))
        items.add(StackCard(0, "➕ Добавить расход", "", emptyList(), true))
    }
    override fun getCount(): Int = items.size
    override fun getViewAt(position: Int): RemoteViews {
        val card = items[position]
        val views = RemoteViews(context.packageName, R.layout.widget_stack_card)
        views.setTextViewText(R.id.card_title, card.title)
        if (card.subtitle.isNotEmpty()) { views.setTextViewText(R.id.card_subtitle, card.subtitle); views.setViewVisibility(R.id.card_subtitle, View.VISIBLE) }
        else views.setViewVisibility(R.id.card_subtitle, View.GONE)
        views.setViewVisibility(R.id.card_add_expense, if (card.isAddExpense) View.VISIBLE else View.GONE)
        val lineIds = intArrayOf(R.id.card_line1, R.id.card_line2, R.id.card_line3)
        for (i in lineIds.indices) {
            if (i < card.lines.size) { views.setTextViewText(lineIds[i], card.lines[i]); views.setViewVisibility(lineIds[i], View.VISIBLE) }
            else views.setViewVisibility(lineIds[i], View.GONE)
        }
        if (card.lines.isEmpty() && !card.isAddExpense) { views.setTextViewText(R.id.card_line1, "Пока пусто"); views.setViewVisibility(R.id.card_line1, View.VISIBLE) }
        val fillIn = if (card.isAddExpense) Intent().apply { data = Uri.parse("vmeste://open?action=addExpense") }
                     else Intent().apply { data = Uri.parse("vmeste://open?tab=${card.tab}") }
        views.setOnClickFillInIntent(R.id.card_root, fillIn)
        return views
    }
    override fun getLoadingView(): RemoteViews { val v = RemoteViews(context.packageName, R.layout.widget_stack_card); v.setTextViewText(R.id.card_title, "Загрузка…"); return v }
    override fun getViewTypeCount(): Int = 1
    override fun getItemId(position: Int): Long = position.toLong()
    override fun hasStableIds(): Boolean = true
    override fun onDestroy() {}
}