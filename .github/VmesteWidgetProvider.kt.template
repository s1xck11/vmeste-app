package com.vmeste.vmeste_app

import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.appwidget.AppWidgetProvider
import android.content.Context
import android.content.Intent
import android.net.Uri
import android.view.View
import android.widget.RemoteViews
import android.widget.RemoteViewsService
import es.antonborri.home_widget.HomeWidgetLaunchIntent
import es.antonborri.home_widget.HomeWidgetPlugin

abstract class BaseVmesteWidget : AppWidgetProvider() {
    abstract val layoutId: Int
    abstract val iconEmoji: String
    abstract val prefTitle: String
    abstract val prefLines: String
    abstract val prefSub: String
    abstract val tabIndex: Int

    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
        for (widgetId in appWidgetIds) updateWidget(context, appWidgetManager, widgetId)
    }

    private fun updateWidget(context: Context, appWidgetManager: AppWidgetManager, widgetId: Int) {
        val views = RemoteViews(context.packageName, layoutId)
        val prefs = HomeWidgetPlugin.getData(context)
        val title = prefs.getString(prefTitle, "") ?: ""
        val linesRaw = prefs.getString(prefLines, "") ?: ""
        val sub = prefs.getString(prefSub, "") ?: ""
        val lines = if (linesRaw.isEmpty()) emptyList() else linesRaw.split("\n").filter { it.isNotEmpty() }

        views.setTextViewText(R.id.widget_icon, iconEmoji)
        views.setTextViewText(R.id.widget_title, title)
        views.setTextViewText(R.id.widget_subtitle, sub)

        val lineIds = intArrayOf(R.id.widget_line0, R.id.widget_line1, R.id.widget_line2, R.id.widget_line3)
        for (i in lineIds.indices) {
            if (i < lines.size) {
                views.setTextViewText(lineIds[i], lines[i])
                views.setViewVisibility(lineIds[i], View.VISIBLE)
            } else {
                views.setTextViewText(lineIds[i], "")
                views.setViewVisibility(lineIds[i], View.GONE)
            }
        }
        if (lines.isEmpty()) {
            views.setTextViewText(R.id.widget_sub, "Пока пусто")
            views.setViewVisibility(R.id.widget_sub, View.VISIBLE)
        } else {
            views.setViewVisibility(R.id.widget_sub, View.GONE)
        }
        val intent = HomeWidgetLaunchIntent.getActivity(context, MainActivity::class.java, Uri.parse("vmeste://open?tab=$tabIndex"))
        views.setOnClickPendingIntent(R.id.widget_root, intent)
        appWidgetManager.updateAppWidget(widgetId, views)
    }
}

