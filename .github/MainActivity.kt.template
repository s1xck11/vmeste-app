package com.vmeste.vmeste_app

import android.content.Intent
import android.os.Bundle
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {
    private val channelName = "com.vmeste.app/deeplink"
    private var channel: MethodChannel? = null
    private var pendingAction: String? = null
    private var pendingTab: Int? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        parseIntent(intent)
    }

    private fun parseIntent(intent: Intent?) {
        if (intent == null) return
        if (intent.action == "OPEN_EXPENSE") {
            pendingAction = "openExpense"
            return
        }
        val data = intent.data ?: return
        if (data.scheme == "vmeste" && data.host == "open") {
            val tab = data.getQueryParameter("tab")?.toIntOrNull()
            val action = data.getQueryParameter("action")
            if (tab != null) pendingTab = tab
            if (action != null) pendingAction = action
        }
    }

    private fun buildPayload(): Map<String, Any?> {
        val map = mutableMapOf<String, Any?>()
        if (pendingTab != null) map["tab"] = pendingTab
        if (pendingAction != null) map["action"] = pendingAction
        pendingTab = null
        pendingAction = null
        return map
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        channel = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, channelName)
        channel?.setMethodCallHandler { call, result ->
            when (call.method) {
                "getInitialAction" -> {
                    val payload = buildPayload()
                    result.success(if (payload.isEmpty()) null else payload)
                }
                "showExpenseNotification" -> {
                    ExpenseNotificationService.show(this)
                    result.success(true)
                }
                "hideExpenseNotification" -> {
                    ExpenseNotificationService.hide(this)
                    result.success(true)
                }
                else -> result.notImplemented()
            }
        }
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        parseIntent(intent)
        val payload = buildPayload()
        if (payload.isNotEmpty()) {
            channel?.invokeMethod("deepLink", payload)
        }
    }
}